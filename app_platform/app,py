    enabled = bool(body.get("enabled", True))
    ok = store.set_agent_enabled(agent_id, enabled)
    return jsonify({"ok": ok, "enabled": enabled})


@app.get("/api/rag")
def api_rag_list():
    return jsonify(store.list_rag_docs(active_only=False))


@app.post("/api/rag")
def api_rag_add():
    """Add a document to platform_db AND re-ingest into the real vector store
    so the Memory/RAG agent retrieves it on the next query."""
    body = request.get_json(force=True) or {}
    title = body.get("title", "").strip()
    content = body.get("content", "").strip()
    topic = body.get("topic", "general")
    if not title or not content:
        return jsonify({"error": "title and content required"}), 400
    doc_id = store.add_rag_doc(title, topic, content)
    try:
        n_chunks = ingest_platform_doc(doc_id, title, topic, content)
    except Exception as e:
        n_chunks = 0
        return jsonify({"ok": True, "doc_id": doc_id, "vector_ingest": False, "error": str(e)})
    return jsonify({"ok": True, "doc_id": doc_id, "vector_ingest": True, "chunks": n_chunks})


@app.delete("/api/rag/<doc_id>")
def api_rag_remove(doc_id: str):
    """Deactivate in platform_db AND delete chunks from the real vector index."""
    ok = store.remove_rag_doc(doc_id)
    deleted = 0
    try:
        deleted = remove_platform_doc(doc_id)
    except Exception as e:
        return jsonify({"ok": ok, "vector_removed": False, "error": str(e)})
    return jsonify({"ok": ok, "vector_removed": True, "chunks_deleted": deleted})


