@app.post("/api/agents/<agent_id>/tools")
def api_set_tools(agent_id: str):
    """Admin tool allow-list. Persists AND gates runtime via tool_registry
    so the next agent turn can no longer call a disabled tool."""
    body = request.get_json(force=True) or {}
    tools = body.get("tools")
    if not isinstance(tools, list):
        return jsonify({"error": "tools must be a list"}), 400
    ok = tool_registry.set_enabled_tools(agent_id, tools)
    enabled = tool_registry.get_enabled_tools(agent_id)
    return jsonify({"ok": ok, "tools": enabled, "catalogue": tool_registry.describe_tools(agent_id)})


